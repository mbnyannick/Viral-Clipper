# ── Telegram ───────────────────────────────────────────────────────────────────
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your personal Telegram user ID (not the bot's). Use @userinfobot to get it.
TELEGRAM_OPERATOR_CHAT_ID=

# ── API Keys ────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# ── Transcription (Deepgram Nova-2 is primary, Groq is fallback) ──────────────
# DEEPGRAM_API_KEY=

# ── Public hosting / webhooks ───────────────────────────────────────────────────
# Base URL where clips/thumbnails are publicly served (used for posting payloads)
# PUBLIC_BASE_URL=https://your-vm-ip.sslip.io

# ── Pipeline tuning ─────────────────────────────────────────────────────────────
# How many top clips to identify per video
TOP_N_CLIPS=10

# Duration of each audio chunk sent for transcription (minutes). Keep ≤ 15 to stay under 25MB.
CHUNK_DURATION_MINUTES=15

# DeepSeek model to use for moment scoring (deepseek-chat or deepseek-reasoner)
DEEPSEEK_MODEL=deepseek-chat
