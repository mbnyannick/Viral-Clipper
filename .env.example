# ── Telegram ───────────────────────────────────────────────────────────────────
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your personal Telegram user ID (not the bot's). Use @userinfobot to get it.
TELEGRAM_OPERATOR_CHAT_ID=

# ── API Keys ────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# ── Pipeline tuning ─────────────────────────────────────────────────────────────
# How many top clips to identify per video
TOP_N_CLIPS=10

# Duration of each audio chunk sent to Groq (minutes). Keep ≤ 15 to stay under 25MB.
CHUNK_DURATION_MINUTES=15

# DeepSeek model to use for moment scoring (deepseek-chat or deepseek-reasoner)
DEEPSEEK_MODEL=deepseek-chat
